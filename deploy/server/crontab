# deploy user's crontab on la-zone — replaces the "crons" block of
# apps/web/vercel.json. Times are UTC, same as Vercel Cron.
# Install: sudo crontab -u deploy /path/to/this/file
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
LOG=/srv/la-zone/logs/cron.log

# NHL data for the pool (hockey brand only; the others skip it anyway).
0 9 * * *    /srv/la-zone/bin/run-cron.sh zonenordiques /api/cron/nhl-sync >> $LOG 2>&1

# Safety net for translations (publishing already translates right away).
0 6 * * *    for b in zonenordiques zoneexpos cflquebec; do /srv/la-zone/bin/run-cron.sh $b /api/translate-pending; done >> $LOG 2>&1

# Polls and the newsletter are switched off by choice (2026-10-23).
# Re-enable a line to turn the feature back on for all three brands.
